[Unit]
Description=qingli 实时变更监听（fanotify）
Documentation=file:/usr/share/doc/qingli/DESIGN.md
After=local-fs.target
# 全量扫描进程与本进程共享同一个 SQLite 库（WAL 支持多读单写），互不阻塞
Before=qingli-scan.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/qingli watch {{ROOT}} --db /var/lib/qingli/qingli.db
# 队列溢出会置 needs_full_rescan；单次读失败不应让进程退出，因此 always 重启
Restart=always
RestartSec=5

# 精确授权，而不是整机 root 裸跑：
#   CAP_SYS_ADMIN —— fanotify_init/mark（若改用 FAN_MARK_FILESYSTEM 亦需要）
# 说明：本实现只标记挂载点 + FAN_MODIFY/CLOSE_WRITE，事件带 fd 可直接解析路径，
#       因此**不需要** CAP_DAC_READ_SEARCH。
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qingli
PrivateTmp=yes

# 队列溢出会置 needs_full_rescan；不因单次读失败而退出
Restart=on-failure

[Install]
WantedBy=multi-user.target
